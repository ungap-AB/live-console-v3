{
  "name": "live-console-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run i18n:compile",
    "build": "tsc -b && vite build",
    "prebuild": "npm run i18n:compile",
    "preview": "vite preview",
    "test": "node --import ./scripts/test-setup.mjs --test \"src/**/*.test.ts\"",
    "pretest": "npm run i18n:compile",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n:check": "lingui check sync && lingui check missing && node scripts/i18n-check-shared.mjs"
  },
  "dependencies": {
    "@lingui/core": "^6.9.1",
    "amazon-ivs-player": "^1.56.1",
    "events": "^3.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.9.1",
    "@lingui/cli": "^6.9.1",
    "@lingui/format-po": "^6.9.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "pofile-ts": "^4.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
